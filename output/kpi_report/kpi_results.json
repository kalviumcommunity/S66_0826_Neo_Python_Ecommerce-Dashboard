      "kpi_name": "Revenue Per Customer",
      "description": "Average total payment value earned per unique customer. Measures how much each customer contributes to platform revenue.",
      "formula": "SUM(payment_value) / COUNT(DISTINCT customer_unique_id)",
      "data_source": [
        "olist_order_payments_dataset.csv",
        "olist_customers_dataset.csv",
        "olist_orders_dataset.csv"
      ],
      "owner": "Revenue Analytics",
      "update_frequency": "Monthly",
      "unit": "BRL",
      "target_min": 100.0,
      "target_max": 300.0,
      "computed_value": 166.59,
      "within_target": true,
      "status": "PASS",
      "deviation_notes": []
    },
    {
      "kpi_name": "Order Fulfillment Rate",
      "description": "Proportion of orders that were successfully delivered to the customer. Indicates logistics reliability and operational quality.",
      "formula": "COUNT(order_id WHERE order_status = 'delivered') / COUNT(order_id) * 100",
      "data_source": [
        "olist_orders_dataset.csv"
      ],
      "owner": "Operations",
      "update_frequency": "Weekly",
      "unit": "%",
      "target_min": 90.0,
